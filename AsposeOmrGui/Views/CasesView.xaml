<UserControl x:Class="AsposeOmrGui.Views.CasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="940">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Heading + toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StepBadge}">
                    <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Recognize your scans" Style="{StaticResource H1}" FontSize="20" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Template:" />
                        <Run Text="{Binding ActiveTemplateName, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Case list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Cases" Style="{StaticResource H2}" Margin="0,0,0,8" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="➕  Add case (choose scan files)…" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddCaseCommand}" HorizontalAlignment="Stretch" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Run again" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RunCaseCommand}" CommandParameter="{Binding SelectedCase}"
                                    Margin="0,0,4,0" />
                            <Button Grid.Column="1" Content="Remove" Style="{StaticResource DangerButton}"
                                    Command="{Binding RemoveCaseCommand}" CommandParameter="{Binding SelectedCase}"
                                    Margin="4,0,0,0" />
                        </Grid>
                        <Button Content="Run all pending" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RunAllCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Grid>
                        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="6,20"
                                   Text="No cases yet. Click “Add case” and pick one or more scanned files."
                                   Visibility="{Binding HasCases, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <ListBox ItemsSource="{Binding Cases}"
                                 SelectedItem="{Binding SelectedCase, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 Visibility="{Binding HasCases, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,5">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="&#9679;" Foreground="{Binding StatusBrush}"
                                                       FontSize="12" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" FontSize="12" />
                                            <TextBlock Text="  ·  " Style="{StaticResource Hint}" FontSize="12" />
                                            <TextBlock Text="{Binding FileCount, StringFormat='{}{0} file(s)'}"
                                                       Style="{StaticResource Hint}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Case detail -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" VerticalAlignment="Center"
                               Text="Select a case to see its recognized answers."
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedCase}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="17" VerticalAlignment="Center" />
                                <Border Background="{Binding StatusBrush}" CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" />
                                </Border>
                            </StackPanel>

                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,2"
                                       Text="{Binding LastRunDisplay, StringFormat='Last run: {0}'}"
                                       Visibility="{Binding LastRunDisplay, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,10"
                                       Text="{Binding FilesDisplay}" ToolTip="{Binding FilesTooltip}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Error -->
                            <Border Background="#FDECEC" CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                                    Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}">
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Answers -->
                            <TextBlock Text="Recognized answers" Style="{StaticResource H2}" Margin="0,4,0,6"
                                       Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" />
                            <DataGrid ItemsSource="{Binding Answers}" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="Transparent" RowBackground="White" BorderBrush="{StaticResource BorderBrush}"
                                      HorizontalScrollBarVisibility="Auto" MaxHeight="320"
                                      Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Question" Binding="{Binding QuestionName}" Width="2*" />
                                    <DataGridTextColumn Header="Answer" Binding="{Binding Answer}" Width="2*" />
                                    <DataGridTextColumn Header="Type" Width="*"
                                                        Binding="{Binding IsFreeInput, Converter={StaticResource FreeInputTypeConverter}}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Write-in images -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding HasWriteInImages, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Handwriting / write-in images" Style="{StaticResource H2}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding WriteInImages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" Margin="0,0,8,8" Padding="4" Background="White">
                                                <Image Source="{Binding}" MaxHeight="80" Stretch="Uniform" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Raw CSV (advanced) -->
                            <Expander Header="Advanced: raw CSV result" Margin="0,14,0,0"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Visibility="{Binding RawCsv, Converter={StaticResource NotEmptyToVis}}">
                                <TextBox Text="{Binding RawCsv, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"
                                         TextWrapping="NoWrap" AcceptsReturn="True" MaxHeight="220"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
