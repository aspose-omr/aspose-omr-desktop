<UserControl x:Class="AsposeOmrGui.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:AsposeOmrGui.Controls"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="940">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Heading + export -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource StepBadge}">
                    <TextBlock Text="4" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="See the results" Style="{StaticResource H1}" FontSize="20" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Hint}" />
                </StackPanel>
            </StackPanel>

            <Button Content="⬇  Export all results to CSV…" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding ExportCsvCommand}" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasQuestions, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" VerticalAlignment="Center"
                           Text="{Binding SummaryText}" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasQuestions, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <!-- CardRoot is what gets exported to PNG (title + chart + legend) -->
                                <Border x:Name="CardRoot" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HeaderText}" Style="{StaticResource H2}" FontSize="16" />
                                        <TextBlock Text="{Binding ModeText}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,10" />

                                        <!-- Pie chart (choice questions) -->
                                        <controls:PieChartControl Slices="{Binding Slices}"
                                                                  Height="200"
                                                                  Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}" />

                                        <!-- Free-text list (handwriting questions) -->
                                        <ItemsControl ItemsSource="{Binding FreeValues}"
                                                      Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding CaseName}"
                                                                   Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Save PNG (charts only), placed outside CardRoot so it is not in the image -->
                                <Button Content="Save chart as PNG…" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Tag="{Binding ElementName=CardRoot}"
                                        Click="SavePng_Click"
                                        Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
