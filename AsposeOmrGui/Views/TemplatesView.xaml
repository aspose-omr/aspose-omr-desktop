<UserControl x:Class="AsposeOmrGui.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Style="{StaticResource StepBadge}">
                <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Choose a form template" Style="{StaticResource H1}" FontSize="20" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Add one or more .omr templates and pick which one you are working with." />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Template list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Your templates" Style="{StaticResource H2}" Margin="0,0,0,8" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="➕  Add template…" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddTemplateCommand}" HorizontalAlignment="Stretch" />
                        <Button Content="Remove selected" Style="{StaticResource DangerButton}"
                                Command="{Binding RemoveTemplateCommand}" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Grid>
                        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="6,20"
                                   Text="No templates yet. Click “Add template…” to pick an .omr file."
                                   Visibility="{Binding HasTemplates, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                        <ListBox ItemsSource="{Binding Templates}"
                                 SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 Visibility="{Binding HasTemplates, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Hint}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="⚠ file not found" Foreground="{StaticResource DangerBrush}"
                                                   FontSize="11"
                                                   Visibility="{Binding FileExists, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Selected template details -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" VerticalAlignment="Center"
                               Text="Select a template on the left to see its settings."
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedTemplate}">
                            <TextBlock Text="Template name" Style="{StaticResource H2}" />
                            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,14" />

                            <TextBlock Text="Template file" Style="{StaticResource H2}" />
                            <Border Background="{StaticResource SubtleBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,4,0,16">
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                           FontSize="13" ToolTip="{Binding Path}" />
                            </Border>

                            <TextBlock Text="Handwriting" Style="{StaticResource H2}" />
                            <CheckBox Content="Read handwritten text fields (Aspose.OMR.Handwriting plugin)"
                                      IsChecked="{Binding UsePlugin, Mode=TwoWay}" Margin="0,4,0,2" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                       Text="Turn this on only if your form has handwritten text or character boxes to read as text."/>

                            <!-- Advanced -->
                            <Expander Header="Advanced settings" Margin="0,14,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                                <StackPanel Margin="0,10,0,0">
                                    <CheckBox Content="Decide mark sensitivity automatically (recommended)"
                                              IsChecked="{Binding UseAutoThreshold, Mode=TwoWay}" />

                                    <StackPanel Margin="0,8,0,0"
                                                IsEnabled="{Binding UseAutoThreshold, Converter={StaticResource InverseBool}}">
                                        <TextBlock Style="{StaticResource Hint}">
                                            <Run Text="Fill threshold: " />
                                            <Run Text="{Binding ThresholdValue, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="%" />
                                        </TextBlock>
                                        <Slider Minimum="0" Maximum="100"
                                                Value="{Binding ThresholdValue, Mode=TwoWay}"
                                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                                   Text="Lower = catch faint marks (more noise). Higher = only solid marks." />
                                    </StackPanel>

                                    <CheckBox Content="Boost faint pencil marks on poor scans"
                                              IsChecked="{Binding ApplyLightShadeProcessing, Mode=TwoWay}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
