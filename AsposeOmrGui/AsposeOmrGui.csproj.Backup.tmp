<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AsposeOmrGui</RootNamespace>
    <AssemblyName>AsposeOmrGui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Aspose.OMR + the ONNX-backed Handwriting plugin ship Windows x64 native bits;
         pin the platform so the correct native runtime is copied to the output folder. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Keep startup resilient on machines that only have a newer desktop runtime. -->
    <RollForward>LatestMajor</RollForward>
    <Version>1.0.0</Version>
    <Product>Aspose OMR</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspose.OMR" Version="26.1.0" />
    <PackageReference Include="Aspose.OMR.Handwriting" Version="24.7.0" />
  </ItemGroup>

</Project>
